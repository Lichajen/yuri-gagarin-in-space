[gd_resource type="Resource" script_class="Exchange" format=3 uid="uid://b6v5qaf5fikw"]

[ext_resource type="Script" uid="uid://bmold5q5uayal" path="res://scripts/dialogue_option.gd" id="1_option"]
[ext_resource type="Script" uid="uid://cfmpvfu6nlaqa" path="res://scripts/exchange.gd" id="2_exchange"]

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("1_option")
text = "\"Zarya-1, Kedr. Confirmed. I'm... going somewhere new.\""
next_id = "korolev_silence"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("1_option")
text = "[Say nothing. Watch Earth get smaller in the window]"
next_id = "korolev_silence"

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("1_option")
text = "\"Sergei Pavlovich, your engine was stronger than you thought.\""
next_id = "korolev_silence"

[resource]
script = ExtResource("2_exchange")
id = "reply_to_zarya"
options = Array[ExtResource("1_option")]([SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])
